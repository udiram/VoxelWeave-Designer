---
import BaseLayout from '../components/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const githubUrl = import.meta.env.PUBLIC_GITHUB_URL ?? 'https://github.com/udbhavram/VoxelWeave';
---

<BaseLayout
  title="VoxelWeave Designer — CT phantom design from source volume to scan-back"
  description="VoxelWeave Designer is a research-only Apple Silicon workspace for converting complete CT DICOM series and modeled solids into calibrated, inspectable Prusa XL print packages."
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__inner">
      <div class="hero__copy">
        <h1 id="hero-heading">Design CT phantoms from source volume to scan-back.</h1>
        <p class="hero__lede">
          VoxelWeave Designer turns complete DICOM series and modeled solids into calibrated, inspectable Prusa XL print packages—without confusing a software preview for physical evidence.
        </p>
        <div class="button-row">
          <a class="button-primary" data-download-cta href="#evidence">Download for Apple Silicon</a>
          <a class="button-secondary" href={githubUrl} target="_blank" rel="noreferrer">View on GitHub <Icon name="external" size={16} /></a>
        </div>
        <p class="hero__note">Research use only · macOS 14+ · Apple Silicon</p>
      </div>

      <figure class="product-proof">
        <div class="laptop" aria-label="VoxelWeave Designer DICOM workspace product proof">
          <div class="laptop__screen">
            <span class="laptop__camera" aria-hidden="true"></span>
            <img
              src="/assets/workspace-dicom.png"
              width="1536"
              height="1024"
              alt="VoxelWeave Designer DICOM workspace showing synchronized axial, sagittal, coronal, and 3D views with source and print-selection controls"
              fetchpriority="high"
            />
          </div>
          <div class="laptop__base" aria-hidden="true"></div>
        </div>
        <figcaption>Complete-series geometry, synchronized MPR, and print selection in one workspace.</figcaption>
        <p class="asset-note">Product proof uses the accepted DICOM workspace concept as a provenance-backed visual reference; no raw DICOM files or patient identifiers are published.</p>
      </figure>
    </div>

    <div class="hero-flow" aria-labelledby="source-flow-heading">
      <h2 id="source-flow-heading">Source-to-scan workflow</h2>
      <div class="flow-preview" tabindex="0" aria-label="Scroll the source-to-scan workflow horizontally on narrow screens">
        <article class="flow-preview__item">
          <Icon name="database" size={24} class="flow-preview__icon" />
          <h3>1. Source DICOM</h3>
          <p>Import complete DICOM series with correct voxel geometry.</p>
        </article>
        <article class="flow-preview__item">
          <Icon name="cube" size={24} class="flow-preview__icon" />
          <h3>2. Build Geometry</h3>
          <p>Combine segmentations and modeled solids in physical coordinates.</p>
        </article>
        <article class="flow-preview__item">
          <Icon name="target" size={24} class="flow-preview__icon" />
          <h3>3. Calibrate &amp; Align</h3>
          <p>Verify position and materials against source in the DICOM viewer.</p>
        </article>
        <article class="flow-preview__item">
          <Icon name="toolpath" size={24} class="flow-preview__icon" />
          <h3>4. Package for Prusa XL</h3>
          <p>Generate G-code and metadata with locked print parameters.</p>
        </article>
        <article class="flow-preview__item">
          <Icon name="scan" size={24} class="flow-preview__icon" />
          <h3>5. Print &amp; Scan-back</h3>
          <p>Print the phantom and acquire scan-back for comparison.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="workflow-section" id="workflow" aria-labelledby="workflow-heading">
    <div class="section-shell">
      <div class="section-heading">
        <h2 id="workflow-heading">One project. Six accountable workspaces.</h2>
        <p>Every transition preserves source coordinates, calibration identity, tool ownership, emitted paths, and verification evidence.</p>
      </div>

      <div class="bench-scroll" tabindex="0" aria-label="Scroll the fabrication bench horizontally on narrow screens">
        <div class="bench-crop">
          <img
            src="/assets/fabrication-bench.png"
            width="1536"
            height="1024"
            alt="Fabrication bench showing VoxelWeave Designer screens for geometry, DICOM, calibration, toolpaths, export, and registered scan-back"
            loading="lazy"
          />
        </div>
      </div>
      <p class="bench-caption">Accepted fabrication-bench concept treatment, paired with the code-native workspace contract below.</p>

      <div class="workspace-rail" role="list" aria-label="VoxelWeave Designer workspaces">
        <article class="workspace-rail__item" role="listitem">
          <Icon name="cube" size={24} />
          <h3>Design</h3>
          <p>Solids and material regions</p>
        </article>
        <article class="workspace-rail__item" role="listitem">
          <Icon name="database" size={24} />
          <h3>DICOM</h3>
          <p>Full-resolution HU source</p>
        </article>
        <article class="workspace-rail__item" role="listitem">
          <Icon name="toolpath" size={24} />
          <h3>Calibrate</h3>
          <p>Width-to-HU evidence</p>
        </article>
        <article class="workspace-rail__item" role="listitem">
          <Icon name="layers" size={24} />
          <h3>Prepare</h3>
          <p>Exact emitted paths</p>
        </article>
        <article class="workspace-rail__item" role="listitem">
          <Icon name="download" size={24} />
          <h3>Send</h3>
          <p>Export or Prusa Connect</p>
        </article>
        <article class="workspace-rail__item" role="listitem">
          <Icon name="verify" size={24} />
          <h3>Verify</h3>
          <p>Registered scan-back</p>
        </article>
      </div>
      <p class="workflow-close">Deterministic output, inspectable evidence.</p>
    </div>
  </section>

  <section class="evidence-section" id="evidence" aria-labelledby="evidence-heading">
    <div class="section-shell">
      <div class="evidence-intro">
        <h2 id="evidence-heading">A release you can inspect before you run.</h2>
        <p>Every build publishes the application, checksum, architecture report, test evidence, and source revision together.</p>
      </div>

      <div class="release-grid">
        <div class="release-panel" data-release-panel>
          <div class="release-panel__header">
            <h3 data-release-heading>Current public build</h3>
            <span class="release-tag" data-release-tag aria-live="polite"></span>
          </div>
          <div class="release-state" data-release-loading aria-live="polite">
            <p>Checking the current public release…</p>
          </div>
          <div class="release-state" data-release-empty hidden>
            <p><strong>No signed public build is published yet.</strong> The release service has no Apple Silicon artifact to link. Follow the <a href={githubUrl} target="_blank" rel="noreferrer">GitHub source</a> for the reproducible project and return here when a release is published.</p>
          </div>
          <div class="release-state" data-release-error hidden>
            <p><strong>Release details are temporarily unavailable.</strong> The site could not read the release service. The <a href={githubUrl} target="_blank" rel="noreferrer">GitHub source</a> remains available.</p>
          </div>
          <div data-release-table hidden>
            <div class="release-table-wrap">
              <table class="release-table">
                <caption class="sr-only">Current VoxelWeave Designer release artifacts</caption>
                <thead>
                  <tr>
                    <th scope="col">Artifact</th>
                    <th scope="col">Architecture</th>
                    <th scope="col">Size</th>
                    <th scope="col">SHA-256</th>
                    <th scope="col"><span class="sr-only">Download</span></th>
                  </tr>
                </thead>
                <tbody data-release-rows></tbody>
              </table>
            </div>
            <div class="release-meta" aria-label="Release metadata">
              <span><strong>Source revision</strong> <code data-source-revision>—</code></span>
              <span><strong>Published</strong> <time data-published-at>—</time></span>
            </div>
          </div>
          <div class="release-actions">
            <a class="button-primary" data-download-cta data-release-download-cta data-source-url={githubUrl} href={githubUrl}><Icon name="download" size={19} /> <span data-download-label>Download VoxelWeave Designer</span></a>
            <a class="text-link" href="/installation/">Read the installation guide <Icon name="arrow" size={18} /></a>
          </div>
        </div>

        <div>
          <div class="install-panel">
            <h3>macOS download &amp; install</h3>
            <div class="install-window" aria-label="macOS disk image installation illustration">
              <div class="window-bar" aria-hidden="true">
                <span class="window-dot window-dot--red"></span>
                <span class="window-dot window-dot--amber"></span>
                <span class="window-dot window-dot--green"></span>
                <span class="window-title">VoxelWeave Designer</span>
              </div>
              <div class="window-body">
                <div>
                  <div class="app-cube" aria-hidden="true">V</div>
                  <strong>VoxelWeave Designer.app</strong>
                </div>
                <div class="install-arrow" aria-hidden="true"><Icon name="arrow" size={30} /></div>
                <div>
                  <div class="app-cube" style="background: #3195c5; border-color: #17617f;" aria-hidden="true">A</div>
                  <strong>Applications</strong>
                </div>
              </div>
            </div>
          </div>
          <div class="architecture-panel">
            <h3>Architecture receipt</h3>
            <pre class="architecture-receipt"><span class="prompt">$</span> uname -m
arm64
<span class="prompt">$</span> <span aria-hidden="true">▮</span></pre>
            <p class="install-copy">The v1 desktop package targets macOS 14+ on Apple Silicon. Intel, Windows, Linux, Rosetta, and universal binaries are outside this release contract.</p>
          </div>
        </div>
      </div>

      <ul class="evidence-band" data-evidence-checks aria-label="Release evidence checks">
        <li class="evidence-check" data-check-id="unit-integration" data-status="not-published">
          <span class="evidence-check__icon"><Icon name="check" size={16} /></span>
          <span>Unit + integration<small data-check-detail>Not published</small></span>
        </li>
        <li class="evidence-check" data-check-id="desktop-e2e" data-status="not-published">
          <span class="evidence-check__icon"><Icon name="check" size={16} /></span>
          <span>Desktop E2E<small data-check-detail>Not published</small></span>
        </li>
        <li class="evidence-check" data-check-id="accessibility" data-status="not-published">
          <span class="evidence-check__icon"><Icon name="check" size={16} /></span>
          <span>Accessibility<small data-check-detail>Not published</small></span>
        </li>
        <li class="evidence-check" data-check-id="architecture" data-status="not-published">
          <span class="evidence-check__icon"><Icon name="check" size={16} /></span>
          <span>Architecture<small data-check-detail>Not published</small></span>
        </li>
        <li class="evidence-check" data-check-id="release-checksum" data-status="not-published">
          <span class="evidence-check__icon"><Icon name="check" size={16} /></span>
          <span>Release checksum<small data-check-detail>Not published</small></span>
        </li>
      </ul>
    </div>
  </section>

  <section class="boundary-section" aria-labelledby="boundary-heading">
    <div class="section-shell">
      <div>
        <h2 id="boundary-heading">Software evidence stops at the printer.</h2>
        <p>VoxelWeave can verify source geometry, calibration identity, emitted paths, and file integrity. It cannot establish deposited width or physical HU fidelity. Those conclusions require an accepted calibration and CT scan-back.</p>
      </div>
      <nav class="boundary-links" aria-label="Scientific boundary links">
        <a href="/scientific-boundary/">Read the scientific boundary <Icon name="arrow" size={18} /></a>
        <a href="/scientific-boundary/#verification">View verification workflow <Icon name="arrow" size={18} /></a>
      </nav>
    </div>
  </section>

  <script src="../scripts/release-client.ts"></script>
</BaseLayout>
