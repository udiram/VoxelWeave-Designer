{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxelWeave Designer",
  "version": "0.1.0",
  "identifier": "com.voxelweave.designer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoxelWeave Designer",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "resources": ["resources/voxelweave-sidecar"],
    "fileAssociations": [
      {
        "ext": ["voxelweave"],
        "mimeType": "application/x-voxelweave",
        "description": "VoxelWeave Designer project"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
